<?xml version="1.0"?>
<ot-sim>
  <message-bus>
    <pull-endpoint>tcp://127.0.0.1:1234</pull-endpoint>
    <pub-endpoint>tcp://127.0.0.1:5678</pub-endpoint>
  </message-bus>

  <cpu>
    <module name="backplane">ot-sim-message-bus {{config_file}}</module>
    <module name="battery">ot-sim-battery-model-module {{config_file}}</module>
    <module name="meter">ot-sim-meter-sim-module {{config_file}}</module>
    <module name="modbus">ot-sim-modbus-module {{config_file}}</module>
    <module name="telnet">ot-sim-telnet-module {{config_file}}</module>
    <module name="io">ot-sim-io-module {{config_file}}</module>
  </cpu>

  <!--
    Battery Model
    =============
    In this HELICS configuration the current command originates from OpenDSS
    (via the IO module subscription below) rather than from a local Update
    write.  The IO module delivers each HELICS time grant as a Status envelope;
    handle_status() in the battery model fires _do_step() on every grant,
    keeping battery physics in lock-step with the OpenDSS time steps.

    Battery outputs (voltage, current, SOC) are pushed onto the msgbus as
    Update envelopes each step so that the IO module can forward them back to
    HELICS via its publication entries below.
  -->
  <battery-model name="bess-1">
    <initial-soc>0.8</initial-soc>
    <dt>1</dt>
    <current-tag>bess-1.current-cmd</current-tag>
    <voltage-tag>bess-1.voltage</voltage-tag>
    <current-out-tag>bess-1.current</current-out-tag>
    <soc-tag>bess-1.soc</soc-tag>
  </battery-model>

  <!--
    Meter Simulator
    ===============
    Publishes simulated three-phase meter readings onto the msgbus and exposes
    them as Modbus TCP holding registers (see Modbus block below).
  -->
  <meter-sim name="meter-1">
    <listen-address>0.0.0.0</listen-address>
    <port>5020</port>
    <unit-id>1</unit-id>
    <update-interval>1</update-interval>
    <tags>
      <voltage-l1>meter-1.voltage-l1</voltage-l1>
      <voltage-l2>meter-1.voltage-l2</voltage-l2>
      <voltage-l3>meter-1.voltage-l3</voltage-l3>
      <current-l1>meter-1.current-l1</current-l1>
      <current-l2>meter-1.current-l2</current-l2>
      <current-l3>meter-1.current-l3</current-l3>
      <active-power>meter-1.active-power</active-power>
      <power-factor>meter-1.power-factor</power-factor>
      <frequency>meter-1.frequency</frequency>
      <energy>meter-1.energy</energy>
    </tags>
  </meter-sim>

  <!--
    Modbus outstation (identical register map to device.xml).

    Battery registers (read-only float32):
      IR 30000–30001 : bess-1.voltage      (V,   float32)
      IR 30002–30003 : bess-1.current      (A,   float32)
      IR 30004–30005 : bess-1.soc          (0–1, float32)

    Battery current setpoint (read/write coil):
      Coil 0 : bess-1.current-cmd  (1 = discharge, 0 = idle)

    Meter registers (read-only float32):
      IR 30010–30029 : meter-1 readings (see device.xml for full map)
  -->
  <modbus name="modbus-outstation" mode="server">
    <endpoint>0.0.0.0:5502</endpoint>

    <register type="coil">
      <address>0</address>
      <tag>bess-1.current-cmd</tag>
    </register>

    <register type="input" data-type="float">
      <address>30000</address>
      <tag>bess-1.voltage</tag>
    </register>
    <register type="input" data-type="float">
      <address>30002</address>
      <tag>bess-1.current</tag>
    </register>
    <register type="input" data-type="float">
      <address>30004</address>
      <tag>bess-1.soc</tag>
    </register>

    <register type="input" data-type="float">
      <address>30010</address>
      <tag>meter-1.voltage-l1</tag>
    </register>
    <register type="input" data-type="float">
      <address>30012</address>
      <tag>meter-1.voltage-l2</tag>
    </register>
    <register type="input" data-type="float">
      <address>30014</address>
      <tag>meter-1.voltage-l3</tag>
    </register>
    <register type="input" data-type="float">
      <address>30016</address>
      <tag>meter-1.current-l1</tag>
    </register>
    <register type="input" data-type="float">
      <address>30018</address>
      <tag>meter-1.current-l2</tag>
    </register>
    <register type="input" data-type="float">
      <address>30020</address>
      <tag>meter-1.current-l3</tag>
    </register>
    <register type="input" data-type="float">
      <address>30022</address>
      <tag>meter-1.active-power</tag>
    </register>
    <register type="input" data-type="float">
      <address>30024</address>
      <tag>meter-1.power-factor</tag>
    </register>
    <register type="input" data-type="float">
      <address>30026</address>
      <tag>meter-1.frequency</tag>
    </register>
    <register type="input" data-type="float">
      <address>30028</address>
      <tag>meter-1.energy</tag>
    </register>
  </modbus>

  <telnet name="battery-meter-telnet">
    <endpoint>:23</endpoint>
    <banner>default</banner>
  </telnet>

  <!--
    IO / HELICS Federate
    ====================
    Bridges the OT-sim message bus to a HELICS co-simulation brokered at
    <broker-endpoint>.  Update the broker-endpoint, federate-name, start-time,
    end-time, and real-time values to match your HELICS broker configuration.

    Data flow
    ---------
    OpenDSS → HELICS subscription → IO module → Status envelope on msgbus
      └─ battery model handle_status() reads bess-1.current-cmd
           └─ _do_step() runs the physics, publishes an Update envelope for
              bess-1.voltage / bess-1.current / bess-1.soc

    Update envelope on msgbus → IO module action_publications() → HELICS
      └─ OpenDSS (or any other federate) can subscribe to these values using
         the federate-name prefix, e.g. bess-1/bess-1.voltage

    Note: the IO module's publication mechanism is driven by Update envelopes.
    Ensure the battery model (or a logic module) pushes Update envelopes—not
    only Status envelopes—for the three output tags when each step completes.
  -->
  <io name="helics-federate">
    <broker-endpoint>127.0.0.1</broker-endpoint>
    <federate-name>bess-1</federate-name>
    <federate-log-level>SUMMARY</federate-log-level>
    <start-time>0</start-time>
    <end-time>3600</end-time>
    <real-time>true</real-time>

    <!--
      Subscription: OpenDSS publishes the battery current setpoint.
      The IO module pushes this as a Status envelope every time grant;
      BatteryModel.handle_status() fires _do_step() on receipt.
    -->
    <subscription>
      <key>OpenDSS/bess-1.current-cmd</key>
      <type>double</type>
      <tag>bess-1.current-cmd</tag>
    </subscription>

    <!--
      Publications: battery model outputs sent back to HELICS each step.
      OpenDSS (or any co-sim federate) subscribes using keys of the form:
        bess-1/bess-1.voltage
        bess-1/bess-1.current
        bess-1/bess-1.soc
    -->
    <publication>
      <key>bess-1.voltage</key>
      <type>double</type>
      <tag>bess-1.voltage</tag>
    </publication>
    <publication>
      <key>bess-1.current</key>
      <type>double</type>
      <tag>bess-1.current</tag>
    </publication>
    <publication>
      <key>bess-1.soc</key>
      <type>double</type>
      <tag>bess-1.soc</tag>
    </publication>
  </io>

</ot-sim>
