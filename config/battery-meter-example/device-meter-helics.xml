<?xml version="1.0"?>
<ot-sim>
  <message-bus>
    <pull-endpoint>tcp://127.0.0.1:1234</pull-endpoint>
    <pub-endpoint>tcp://127.0.0.1:5678</pub-endpoint>
  </message-bus>

  <cpu>
    <module name="backplane">ot-sim-message-bus {{config_file}}</module>
    <module name="meter">ot-sim-meter-sim-helics-module {{config_file}}</module>
    <module name="modbus">ot-sim-modbus-module {{config_file}}</module>
    <module name="io">ot-sim-io-module {{config_file}}</module>
  </cpu>

  <!--
    Meter Simulator (HELICS)
    ========================
    Receives per-EV three-phase currents from HELICS (via IO), computes
    aggregate fleet power and a rolling 1-minute energy usage, and exposes
    all values as Modbus TCP holding registers:

      HR 0-1 : meter-1.energy-consumption  (kWh, float32, passthrough)
      HR 2-3 : meter-1.max-demand          (kW,  float32, peak computed)
      HR 4-5 : meter-1.total-watts         (W,   float32, computed)
      HR 6-7 : meter-1.one-minute-usage    (Wh,  float32, rolling 1-min avg)

    Computed tags are also published to the OT-sim message bus so the
    Modbus outstation below can re-expose them to external clients.
  -->
  <meter-sim-helics name="meter-1">
    <listen-address>0.0.0.0</listen-address>
    <port>5020</port>
    <unit-id>1</unit-id>
    <tags>
      <energy-consumption>meter-1.energy-consumption</energy-consumption>
      <max-demand>meter-1.max-demand</max-demand>
      <total-watts>meter-1.total-watts</total-watts>
      <one-minute-usage>meter-1.one-minute-usage</one-minute-usage>
    </tags>
  </meter-sim-helics>

  <!--
    Modbus outstation – re-exposes all meter values for external Modbus clients
    on a second port.  Remove if the pymodbus server inside MeterSimHelics is
    sufficient.

    Register map (input registers, float32 big-endian):
      IR 30000-30001 : meter-1.energy-consumption  (kWh)
      IR 30002-30003 : meter-1.max-demand          (kW)
      IR 30004-30005 : meter-1.total-watts         (W)
      IR 30006-30007 : meter-1.one-minute-usage    (Wh)

    Read all with mbpoll:
      mbpoll -0 -1 -t 3 -r 0 -c 8 -p 5502 localhost
  -->
  <modbus name="modbus-outstation" mode="server">
    <endpoint>0.0.0.0:5502</endpoint>

    <register type="input" data-type="float">
      <address>0</address>
      <tag>meter-1.energy-consumption</tag>
    </register>
    <register type="input" data-type="float">
      <address>2</address>
      <tag>meter-1.max-demand</tag>
    </register>
    <register type="input" data-type="float">
      <address>4</address>
      <tag>meter-1.total-watts</tag>
    </register>
    <register type="input" data-type="float">
      <address>6</address>
      <tag>meter-1.one-minute-usage</tag>
    </register>
  </modbus>

  <!--
    IO / HELICS Federate
    ====================
    Subscribes to OpenDSS publications for energy consumption and maximum
    demand.  Each HELICS time grant produces a Status envelope on the msgbus
    that MeterSimHelics.handle_status() consumes to update the Modbus registers.

    Adjust broker-endpoint, end-time, and real-time to match your HELICS broker.

    OpenDSS key naming convention used here:
      OpenDSS/<element>.<measurement>
    Adapt the <key> values below to match whatever OpenDSS publishes.
  -->
  <io name="helics-federate">
    <broker-endpoint>127.0.0.1</broker-endpoint>
    <federate-name>meter-1</federate-name>
    <federate-log-level>SUMMARY</federate-log-level>
    <start-time>0</start-time>
    <end-time>3600</end-time>
    <real-time>true</real-time>

    <!-- Meter totals from upstream (optional passthrough) -->
    <subscription>
      <key>CPO1/meter-1.energy-consumption</key>
      <type>double</type>
      <tag>meter-1.energy-consumption</tag>
    </subscription>
    <subscription>
      <key>CPO1/meter-1.max-demand</key>
      <type>double</type>
      <tag>meter-1.max-demand</tag>
    </subscription>

    <!-- EVSE1 three-phase current -->
    <subscription>
      <key>EVSE1/meter-1.current-l1</key>
      <type>double</type>
      <tag>evse-1.current-l1</tag>
    </subscription>
    <subscription>
      <key>EVSE1/meter-1.current-l2</key>
      <type>double</type>
      <tag>evse-1.current-l2</tag>
    </subscription>
    <subscription>
      <key>EVSE1/meter-1.current-l3</key>
      <type>double</type>
      <tag>evse-1.current-l3</tag>
    </subscription>

    <!-- EVSE2 three-phase current -->
    <subscription>
      <key>EVSE2/meter-1.current-l1</key>
      <type>double</type>
      <tag>evse-2.current-l1</tag>
    </subscription>
    <subscription>
      <key>EVSE2/meter-1.current-l2</key>
      <type>double</type>
      <tag>evse-2.current-l2</tag>
    </subscription>
    <subscription>
      <key>EVSE2/meter-1.current-l3</key>
      <type>double</type>
      <tag>evse-2.current-l3</tag>
    </subscription>

    <!-- EVSE3 three-phase current -->
    <subscription>
      <key>EVSE3/meter-1.current-l1</key>
      <type>double</type>
      <tag>evse-3.current-l1</tag>
    </subscription>
    <subscription>
      <key>EVSE3/meter-1.current-l2</key>
      <type>double</type>
      <tag>evse-3.current-l2</tag>
    </subscription>
    <subscription>
      <key>EVSE3/meter-1.current-l3</key>
      <type>double</type>
      <tag>evse-3.current-l3</tag>
    </subscription>
  </io>

</ot-sim>
